# Copy to services/engine/deploy/.env on the droplet (chmod 600). Never commit the real file.
ENGINE_DOMAIN=engine.example.com          # DNS A record → the droplet's IP
PUBLIC_IP=                                # the droplet's IPv4, shown on the Integrations page
ENGINE_SECRET=                            # long random string; same value as ENGINE_SECRET in Vercel
POSTGRES_PASSWORD=                        # long random string

# Delta Exchange India (market data needs no keys)
DELTA_ENV=testnet                         # production only when you mean it
DELTA_TESTNET_API_KEY=
DELTA_TESTNET_API_SECRET=
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_SYMBOLS=BTCUSD,ETHUSD,XAUTUSD
DELTA_EXECUTION=off                       # on = allow order endpoints through this host

# CoinSwitch PRO HFT (even market data is signed)
COINSWITCH_API_KEY=
COINSWITCH_SECRET_KEY=                    # 64 hex characters (Ed25519 seed)
COINSWITCH_SYMBOLS=BTCUSDT,ETHUSDT
COINSWITCH_EXECUTION=off

# Fyers (register this droplet's IP on the new API app)
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=
FYERS_PIN=                                # enables the 15-day refresh-token renewal
FYERS_SYMBOLS=NSE:NIFTY50-INDEX,NSE:NIFTYBANK-INDEX,BSE:SENSEX-INDEX
FYERS_EXECUTION=off
