{
  "name": "aplus-tradeplay",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter @aplus/engine build && pnpm --filter web build",
    "test": "pnpm --filter @aplus/engine test && pnpm --filter @aplus/engine-host test && pnpm --filter web test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter web lint"
  },
  "engines": {
    "node": ">=20"
  }
}
