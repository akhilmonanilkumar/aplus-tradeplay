NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only: investor invites, scheduled passes, Telegram webhook
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://tradeplay.cloud

# AI (OpenRouter gateway; model can also be set in Settings). ANTHROPIC_API_KEY instead uses the API directly.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
ANTHROPIC_API_KEY=
AGENT_MODEL=

# Telegram alerts (send-only). Chats: "-100123:Desk,-100456:Investors" (or add in Settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# CFD prices: the prop broker's cTrader feed comes through the engine host. Next, Twelve Data
# (paid, sign-up works from India) for gold, forex and BTC; OANDA only if you already have an account;
# then the public references (labelled approximate).
TWELVEDATA_API_KEY=
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Macro & news extras (free tiers)
FRED_API_KEY=
FINNHUB_API_KEY=

# Shared secret for the scheduled passes (pg_cron sends it from Supabase Vault; CRON_SECRET also accepted)
AUTOPILOT_SECRET=
CRON_SECRET=

# Engine host (services/engine on the DigitalOcean droplet). Same secret on both sides.
# Venue keys (Delta, CoinSwitch, Fyers, cTrader) live only on the engine host, never here.
ENGINE_URL=
ENGINE_SECRET=
# Delta trading environment the app expects the host to use: testnet (default) or production.
DELTA_ENV=testnet

# Telegram buttons (Taken / Skip on CFD alerts): any long random string, then Integrations → Connect Telegram buttons.
TELEGRAM_WEBHOOK_SECRET=
