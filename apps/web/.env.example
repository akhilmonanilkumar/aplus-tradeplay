NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — investor invites, autopilot, TradingView webhook
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://tradeplay.cloud

# AI (OpenRouter gateway; model can also be set in Settings)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Telegram alerts (send-only). Chats: "-100123:Desk,-100456:Investors" (or add in Settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Broker-grade XAU/USD (either works; OANDA practice accounts are free)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
TWELVEDATA_API_KEY=

# Macro & news extras (free tiers)
FRED_API_KEY=
FINNHUB_API_KEY=

# Shared secret for the 5-minute autopilot scheduler
AUTOPILOT_SECRET=
